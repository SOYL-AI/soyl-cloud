# Credentials the API process must never hold. Alembic reads this file; the
# application does not, and its extra="forbid" would reject these keys if it did
# — which is how this separation stays enforced rather than merely intended.
SOYL_MIGRATION_DATABASE_URL=postgresql+asyncpg://soyl_migrator:soyl_migrator_local@127.0.0.1:5433/soyl
# Only used by scripts/provider_check.py, which creates and drops roles.
SOYL_ADMIN_DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5433/soyl
