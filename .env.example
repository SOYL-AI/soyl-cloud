# Copy to .env.local for development. In production these are set in the
# Vercel project settings — .env* is gitignored and must stay that way.

# Transactional email for the /contact form (src/lib/email.ts).
# Without all three, /api/contact returns 503 and the form shows an error and
# a fallback address. It never reports a false success.
RESEND_API_KEY=
# Must be on a domain with SPF and DKIM verified at the provider, or mail lands
# in spam. e.g. "SOYL Cloud <notifications@soyl.cloud>"
CONTACT_FROM_EMAIL=
# The monitored inbox leads are delivered to.
CONTACT_TO_EMAIL=

# Plausible analytics (src/components/Analytics.tsx). Unset means no script is
# loaded at all — which is how local development and previews should run.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
