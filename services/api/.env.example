# What the API process itself reads. Settings uses extra="forbid", so anything
# in here that the application does not declare is a startup error.
SOYL_ENVIRONMENT=local
SOYL_DATABASE_URL=postgresql+asyncpg://soyl_app:soyl_app_local@localhost:5433/soyl
SOYL_REDIS_URL=redis://localhost:6380/0
SOYL_LEAD_INGEST_TOKEN=local-development-lead-token-not-a-secret
