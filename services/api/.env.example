# What the API process itself reads. Settings uses extra="forbid", so anything
# in here that the application does not declare is a startup error.
SOYL_ENVIRONMENT=local
SOYL_DATABASE_URL=postgresql+asyncpg://soyl_app:soyl_app_local@localhost:5433/soyl
SOYL_REDIS_URL=redis://localhost:6380/0
SOYL_LEAD_INGEST_TOKEN=local-development-lead-token-not-a-secret
SOYL_STORAGE_ENDPOINT_URL=http://localhost:9000
SOYL_STORAGE_BUCKET=soyl-documents
SOYL_STORAGE_ACCESS_KEY=soyl-local
SOYL_STORAGE_SECRET_KEY=soyl-local-secret

# Azure OpenAI (AI Foundry). Absent selects the deterministic fake provider,
# which is correct locally and in CI; staging and prod refuse to boot without
# these because the fake's vectors are not semantic.
SOYL_AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
SOYL_AZURE_OPENAI_API_KEY=
# What you named the deployment in Foundry, which need not match the model.
SOYL_AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
SOYL_AZURE_OPENAI_EMBEDDING_MODEL=text-embedding-3-small
